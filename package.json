{
  "name": "scamsense-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "server:dev": "npm --workspace=server run dev",
    "client:dev": "npm --workspace=client run dev",
    "dev": "npm --workspace=server run dev",
    "test": "npm --workspace=server test",
    "benchmark": "npm --workspace=server run benchmark",
    "build": "npm --workspace=client run build"
  }
}
